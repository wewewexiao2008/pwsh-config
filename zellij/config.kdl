// Zellij configuration with session persistence
// Auto-attach to 'main' session for persistent workspace
// Use PowerShell 7 (pwsh) as default shell for full profile support
// Enable session serialization to restore sessions after system restart

default_session "main" {
    attach_to_session true
    layout "default"
}

// Configure zellij to use PowerShell 7 by default
// This ensures all zellij panes load the pwsh-config profile
default_shell "pwsh"

// Enable session serialization to restore sessions after system restart
session_serialization true
