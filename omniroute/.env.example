# OmniRoute — local-only secrets (DO NOT commit real values)
# Copy to ~/.omniroute/.env and fill in. Generate secrets on each machine.

# Required for encrypted API-key storage / DB (generate per machine):
#   openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=

# Optional: pin listen port if you override defaults (OmniRoute default API is :20128)
# PORT=20128
